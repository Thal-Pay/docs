{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Thal Pay",
  "colors": {
    "primary": "#ff0000",
    "light": "#c90606",
    "dark": "#2200ff"
  },
  "favicon": {
    "light": "/images/FaviconLight.svg",
    "dark": "/images/FaviconDark.svg"
  },
  "api": {
    "baseUrl": "https://api.thalbank.com",
    "auth": {
      "method": "bearer",
      "name": "Authorization"
    },
    "playground": {
      "display": "interactive"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "guides/authentication",
              "guides/idempotency",
              "guides/webhooks",
              "guides/errors"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Authentication",
            "pages": [
              "api-reference/auth/login",
              "api-reference/auth/refresh-token",
              "api-reference/auth/logout"
            ]
          },
          {
            "group": "Transactions",
            "pages": [
              "api-reference/transactions/create",
              "api-reference/transactions/get",
              "api-reference/transactions/list"
            ]
          },
          {
            "group": "Withdrawals",
            "pages": [
              "api-reference/withdrawals/create",
              "api-reference/withdrawals/get",
              "api-reference/withdrawals/list",
              "api-reference/withdrawals/search"
            ]
          },
          {
            "group": "Webhooks",
            "pages": [
              "api-reference/webhooks/create",
              "api-reference/webhooks/list",
              "api-reference/webhooks/get",
              "api-reference/webhooks/delete",
              "api-reference/webhooks/resend-transaction",
              "api-reference/webhooks/resend-withdrawal"
            ]
          },
          {
            "group": "API Keys",
            "pages": [
              "api-reference/api-keys/create",
              "api-reference/api-keys/list",
              "api-reference/api-keys/get",
              "api-reference/api-keys/delete"
            ]
          },
          {
            "group": "Wallet",
            "pages": [
              "api-reference/wallet/get-balance"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "API Status",
          "href": "https://status.thalbank.com",
          "icon": "signal"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/light.svg"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.thalbank.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "cursor"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Thal-Pay",
      "linkedin": "https://www.linkedin.com/company/thal-payhttps://linkedin.com/company/thalpay"
    }
  },
  "description": "Documentação de API - Gateway de Pagamento Thal Pay",
  "fonts": {
    "family": "Montserrat"
  },
  "background": {
    "color": {
      "dark": "#d70000"
    },
    "decoration": "gradient"
  }
}
